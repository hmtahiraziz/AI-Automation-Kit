# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-to-32-plus-random-chars
N8N_API_KEY=
GENERIC_TIMEZONE=America/New_York

# Database
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# LLM — Gemini (AIzaSy... standard or AQ.... authorization — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
