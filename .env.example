# Google OAuth (Gmail + Sheets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Credential test targets (Phase 2)
TEST_GOOGLE_SHEET_ID=
TEST_GOOGLE_SHEET_NAME=Sheet1
TEST_SLACK_CHANNEL=#general

# Main automation workflow
MAIN_GMAIL_TO=you@example.com
# Cron: minute hour day month weekday (default weekdays 6 PM)
MAIN_SCHEDULE_CRON=0 18 * * 1-5

# Dashboard
NEXT_PUBLIC_N8N_URL=http://localhost:5678
NEXT_PUBLIC_KIT_NAME=S-C Automation Kit