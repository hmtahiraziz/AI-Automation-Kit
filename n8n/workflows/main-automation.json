        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "message",
        "operation": "send",
        "sendTo": "__MAIN_GMAIL_TO__",
        "subject": "=Daily Standup - {{ $now.format('MMM d, yyyy') }}",
        "emailType": "html",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px\"><div style=\"background:#18181b;color:#fff;padding:16px\"><h2 style=\"margin:0\">Daily Standup Summary</h2></div><div style=\"padding:16px\"><pre style=\"white-space:pre-wrap;font-family:Arial\">{{ $('Gemini Summary').first().json.text }}</pre></div></div>",
        "options": {}
      },
