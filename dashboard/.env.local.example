# Dashboard — copy to .env.local (never commit)

# Server-only: same key as root .env N8N_API_KEY
N8N_API_KEY=

# n8n base URL for server-side API calls
N8N_INTERNAL_URL=http://localhost:5678

# Public: used for "Open n8n" links in the UI
NEXT_PUBLIC_N8N_URL=http://localhost:5678

# Optional kit display name
NEXT_PUBLIC_KIT_NAME=S-C Automation Kit
